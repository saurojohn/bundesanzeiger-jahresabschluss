# ============================================================================
# Bundesanzeiger Jahresabschluss — Environment Template
# ============================================================================
# Kopieren als .env (lokal) und mit echten Werten füllen.
# NIEMALS .env in Git committen (siehe .gitignore).
# ============================================================================

# ----- General -----
NODE_ENV=development
LOG_LEVEL=info

# ----- Database -----
DATABASE_URL=postgresql://banz:banz_dev_pwd@localhost:5432/banz_jahresabschluss?schema=public
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ----- Database Read-Replica (M4 Sprint 2) -----
# Optional: Wenn gesetzt, werden Read-Queries automatisch an die Replica
# geroutet. Writes bleiben IMMER auf der Primary (DATABASE_URL).
# Production: Managed-PostgreSQL-Replica (Hetzner, AWS RDS).
# Wenn LEER: alle Queries gehen auf Primary (Zero-Impact-Migration).
# DATABASE_READ_REPLICA_URL=postgresql://banz:banz_dev_pwd@replica.local:5432/banz_jahresabschluss?schema=public
DATABASE_POOL_MAX_REPLICA=20

# ----- Redis -----
REDIS_URL=redis://localhost:6379/0

# ----- Cache (M4 Sprint 0) -----
# Cache-Provider: 'memory' (default) oder 'redis'
# Bei 'redis' und nicht erreichbarem Redis: automatischer Fallback auf Memory.
CACHE_PROVIDER=memory

# TTL-Konfiguration (alle in Millisekunden)
CACHE_TTL_MANDANT=300000           # 5 min
CACHE_TTL_AUDIT_COUNT=30000        # 30 s
CACHE_TTL_BRANDING=3600000         # 1 h
CACHE_TTL_PRUEFUNGS_REGEL=86400000  # 24 h

# ----- Auth / JWT -----
# Generieren mit: openssl rand -hex 32
JWT_SECRET=replace-with-256-bit-secret-from-openssl-rand
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
TOTP_ISSUER=Bundesanzeiger-Jahresabschluss
TOTP_WINDOW=1

# ----- BAnz Portal -----
# Bundesanzeiger Verlag Account (Pilot: Sandbox-URL)
BUNDESANZEIGER_PORTAL_BASE_URL=https://test.bundesanzeiger.de
BUNDESANZEIGER_PORTAL_USER=replace-with-portal-user
BUNDESANZEIGER_PORTAL_PWD=replace-with-portal-password
BUNDESANZEIGER_PORTAL_MANDANT_ID=replace-with-mandant-id

# ----- Signatur -----
# P12-Token für qualifizierte Signatur (Pilot: Hardware-Token)
SIGN_P12_PATH=/secure/path/to/token.p12
SIGN_P12_PWD=replace-with-token-password
TSA_URL=https://timestamp.digistamp.com
TSA_USER=replace-with-tsa-user
TSA_PWD=replace-with-tsa-password

# --- Signatur-Zertifikat: Vertrauensbewertung ------------------------------------
# Comma-getrennte Liste der Aussteller-DNs, denen vertraut wird.
# LIEGT SIE LEER, GILT KEIN ZERTIFIKAT ALS VERTRAUENSWÜRDIG (fail-closed).
# Ein selbstsigniertes Zertifikat ist damit immer "nicht vertrauenswuerdig".
# Beispiel: "Bundesamt für Steuerberatung, D-TRUST,D-Trust"
SIGNATURE_TRUSTED_ISSUERS=

# Selbstsignierte Zertifikate zulassen.
# NUR fuer lokale Testumgebungen (scripts-gen-test-p12.ts) auf true setzen.
# Im Pilot-Betrieb MUSS false bleiben — ein selbstsigniertes Zertifikat
# belegt keine Urheberschaft.
SIGNATURE_ALLOW_SELF_SIGNED=false


# ----- WORM-Storage (S3-kompatibel) -----
# Dev: MinIO lokal. Pilot: Hetzner S3 / S3-Cloud.
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=replace-with-access-key
S3_SECRET_KEY=replace-with-secret-key
S3_BUCKET=banz-jahresabschluss-worm
S3_OBJECT_LOCK_MODE=COMPLIANCE
S3_OBJECT_LOCK_RETENTION_DAYS=3650

# ----- PDF-Generation -----
# Footer-Text (unveränderlich; WORM-konform).
PDF_FOOTER_TEXT="Bundesanzeiger Jahresabschluss — GoBD-konform archiviert"

# ----- SMTP / E-Mail -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=replace-with-smtp-user
SMTP_PWD=replace-with-smtp-password
SMTP_FROM=no-reply@banz-jahresabschluss.example

# ----- Frontend (für CORS + Auth-Cookies) -----
FRONTEND_URL=http://localhost:3001
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# ----- Rate Limiting -----
THROTTLE_TTL=60
THROTTLE_LIMIT=600

# ----- Subscription / Billing (M4 Sprint 3) -----
# Stripe-Integration. LEER lassen = Mock-Provider (Dev/Pilot-Phase).
# Production: sk_live_... von https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_replace_me
# STRIPE_WEBHOOK_SECRET=whsec_replace_me
# Stripe-Price-IDs (in Stripe-Dashboard hinterlegt):
# STRIPE_PRICE_PILOT=price_pilot_free
# STRIPE_PRICE_STANDARD=price_standard_49eur
# STRIPE_PRICE_PREMIUM=price_premium_149eur
# STRIPE_API_VERSION=2024-11-20.acacia

# Optional: Stripe-SDK installieren mit `npm install stripe`.

# ----- DNS-Provider (M4 Sprint 3) -----
# Welcher DNS-Provider für Custom-Domain-Verifikation + certbot genutzt wird.
# Werte: hetzner (default) | cloudflare | route53
# DNS_PROVIDER=hetzner

# Hetzner DNS API (https://dns.hetzner.com/api-docs):
# HETZNER_DNS_API_TOKEN=replace-with-hetzner-dns-api-token
# HETZNER_DNS_ZONE_ID=replace-with-zone-id

# Cloudflare (alternativ):
# CLOUDFLARE_API_TOKEN=replace-with-cf-token
# CLOUDFLARE_ZONE_ID=replace-with-cf-zone

# AWS Route53 (alternativ):
# AWS_ACCESS_KEY_ID=replace-with-aws-key
# AWS_SECRET_ACCESS_KEY=replace-with-aws-secret
# AWS_ROUTE53_ZONE_ID=replace-with-route53-zone

# Certbot (für Let's Encrypt Wildcard-Certs):
# Standard-Pfad wo Certs liegen (certbot --live-dir).
# CERTBOT_LIVE_DIR=/etc/letsencrypt/live