# ============================================================================
# Bundesanzeiger Jahresabschluss — Production Env Template (M4 Sprint 2)
# ============================================================================
# Kopieren als .env.prod und mit echten Werten füllen.
# NIEMALS .env.prod in Git committen (siehe .gitignore).
# ============================================================================

# ----- General -----
NODE_ENV=production
LOG_LEVEL=warn
PORT=3000

# ----- Active Pool (Blue/Green) -----
# Welcher Backend-Pool aktiv Traffic bekommt (für NGINX Blue-Green-Switch).
# Wird vom blue-green-switch.sh automatisch gesetzt — manuell nur bei Notfall ändern.
ACTIVE_POOL=blue

# ----- Backend-Skalierung -----
# Wieviele Backend-Instanzen pro Pool laufen sollen (docker-compose --scale).
BACKEND_REPLICA_COUNT=2

# ----- Database (internes Docker-Network) -----
DATABASE_URL=postgresql://banz:CHANGE_ME@postgres-primary:5432/banz_jahresabschluss?schema=public
# Optional: Read-Replica für automatisches Read-Routing (M4 Sprint 2 Phase A).
# Writes gehen IMMER auf DATABASE_URL. Reads gehen auf Replica wenn gesetzt.
DATABASE_READ_REPLICA_URL=postgresql://banz:CHANGE_ME@postgres-replica:5432/banz_jahresabschluss?schema=public
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_POOL_MAX_REPLICA=30

# ----- PostgreSQL Replication (für Container-Setup) -----
POSTGRES_DB=banz_jahresabschluss
POSTGRES_USER=banz
POSTGRES_PASSWORD=CHANGE_ME_SECURE_PASSWORD
POSTGRES_REPLICATION_USER=replicator
POSTGRES_REPLICATION_PASSWORD=CHANGE_ME_SECURE_PASSWORD

# ----- Redis -----
REDIS_URL=redis://redis:6379/0

# ----- Cache -----
CACHE_PROVIDER=redis
CACHE_TTL_MANDANT=300000
CACHE_TTL_AUDIT_COUNT=30000
CACHE_TTL_BRANDING=3600000
CACHE_TTL_PRUEFUNGS_REGEL=86400000

# ----- Auth / JWT -----
# 256-bit: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_64_CHAR_HEX
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
TOTP_ISSUER=Bundesanzeiger-Jahresabschluss
TOTP_WINDOW=1

# ----- BAnz Portal -----
BUNDESANZEIGER_PORTAL_BASE_URL=https://test.bundesanzeiger.de
BUNDESANZEIGER_PORTAL_USER=CHANGE_ME
BUNDESANZEIGER_PORTAL_PWD=CHANGE_ME
BUNDESANZEIGER_PORTAL_MANDANT_ID=CHANGE_ME

# ----- Signatur (qeS) -----
# NIEMALS persistieren — wird in Production via Vault/Secrets-Manager geladen.
SIGN_P12_PATH=/secure/path/to/token.p12
SIGN_P12_PWD=CHANGE_ME
TSA_URL=https://timestamp.digistamp.com
TSA_USER=CHANGE_ME
TSA_PWD=CHANGE_ME

# ----- WORM-Storage (S3-kompatibel via MinIO) -----
S3_ENDPOINT=http://minio:9000
S3_REGION=eu-central-1
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
S3_BUCKET=banz-jahresabschluss-worm
S3_OBJECT_LOCK_MODE=COMPLIANCE
S3_OBJECT_LOCK_RETENTION_DAYS=3650

# ----- PDF-Generation -----
PDF_FOOTER_TEXT="Bundesanzeiger Jahresabschluss — GoBD-konform archiviert"

# ----- SMTP / E-Mail -----
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=true
SMTP_USER=CHANGE_ME
SMTP_PWD=CHANGE_ME
SMTP_FROM=no-reply@banz.example.com

# ----- Frontend -----
FRONTEND_URL=https://banz.example.com
COOKIE_DOMAIN=banz.example.com
COOKIE_SECURE=true

# ----- Rate Limiting -----
THROTTLE_TTL=60
THROTTLE_LIMIT=600

# ----- Cosign (Code-Signing-Verifikation beim Blue-Green-Switch) -----
# Pfad zum Cosign-Public-Key (NICHT der Private-Key!).
# Wird von blue-green-switch.sh gelesen.
COSIGN_PUB_KEY_PATH=/etc/banz/cosign.pub

# ----- Image-Tag (für Blue-Green-Deployment) -----
# Welcher Container-Image-Tag deployed werden soll.
# Wird von blue-green-switch.sh vor jedem Switch aktualisiert.
IMAGE_TAG=latest