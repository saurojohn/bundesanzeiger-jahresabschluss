{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "e2e", "test", "prisma/seed.ts"],
  "ts-node": {
    "//": "files:true laedt ALLE Dateien aus tsconfig.include in das ts-node-Programm — auch .d.ts ohne Runtime-Output. Ohne das fehlt die Express-Request-Augmentation (src/modules/api/types/express.d.ts) zur Laufzeit, waehrend `tsc --noEmit` sie sieht. Symptom: Typecheck gruen, Server startet mit TS2339.",
    "files": true
  }
}
