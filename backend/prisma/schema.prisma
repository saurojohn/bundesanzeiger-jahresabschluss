// ============================================================================
// Bundesanzeiger Jahresabschluss — Prisma Schema
// ============================================================================
// Single source of truth für alle Models.
// Version: 0.1.0 (M1 Sprint 0.3)
// Änderungen IMMER als Migration committen (nicht schema.prisma direkt ändern).
// ============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto]
}

// ============================================================================
// Mandantenfähigkeit (Multi-Tenancy)
// ============================================================================

/// Eine Kanzlei (Steuerberater-Praxis) als Top-Level-Tenant.
/// 1 Kanzlei → n Mandanten (GmbHs / GmbH & Co. KGs).
model Kanzlei {
  id         String  @id @default(uuid()) @db.Uuid
  name       String
  rechtsform String // "Steuerberatungsgesellschaft" | "Wirtschaftsprüfungsgesellschaft" | "Einzelkanzlei"
  adresse    Json // {strasse, plz, ort, land}
  ustId      String? // USt-IdNr.

  // === White-Label Branding (M3 Sprint 4+5) ===
  /// S3/WORM-URL des Kanzlei-Logos (für Frontend-Header + PDF-Branding).
  logoUrl              String?
  /// WORM-Object-Key des Logos (für GoBD-konforme Archivierung).
  logoWormKey          String?
  /// Primärfarbe (Hex #rrggbb) — Headlines, Buttons, Akzente.
  primaryColor         String?   @default("#2563eb")
  /// Sekundärfarbe (Hex #rrggbb) — Hover-States, sekundäre Buttons.
  accentColor          String?   @default("#0ea5e9")
  /// Custom-Domain (FQDN) — z.B. "rechnungen.musterkanzlei.de".
  /// M4: DNS-Verifikation, M3: nur Speicherung + Anzeige.
  customDomain         String?   @unique
  /// true sobald DNS-TXT-Record verifiziert wurde (M4).
  customDomainVerified Boolean   @default(false)
  /// Wann wurde das Branding zuletzt geändert (für Audit + Cache-Invalidation).
  brandingUpdatedAt    DateTime?
  /// Welcher User hat das Branding zuletzt geändert.
  brandingUpdatedById  String?   @db.Uuid

  // === Subscription (M4 Sprint 3) ===
  /// Tier: 'PILOT' (kostenlos, 3 Mandanten) | 'STANDARD' (€49/Monat, 25) | 'PREMIUM' (€149/Monat, unlimited + Custom-Domain + Public-API).
  /// Default: 'PILOT' (zero-impact-migration für Pilot-Kanzleien ohne Stripe-Setup).
  subscriptionTier        String?   @default("PILOT")
  /// Stripe-konforme Statuswerte: 'TRIALING' | 'ACTIVE' | 'PAST_DUE' | 'CANCELED' | 'INCOMPLETE' | 'INCOMPLETE_EXPIRED' | 'UNPAID' | 'PAUSED'.
  /// Default: 'TRIALING' → Feature-Flag-Service gewährt Trial-Zugang bis erste Stripe-Aktivierung.
  subscriptionStatus      String?   @default("TRIALING")
  /// Billing-Provider: 'stripe' (Production) | 'mock' (Dev/Pilot ohne Stripe-Key).
  subscriptionProvider    String?   @default("mock")
  /// Provider-interne Subscription-ID (z.B. Stripe `sub_xxx`). Nullable für Mock-Mode.
  subscriptionProviderId  String?
  /// Nächste Abrechnungsperiode-Ende (für Renewal-UI + Cancellation-Window).
  subscriptionPeriodEnd   DateTime?
  /// True wenn User bereits gekündigt hat — Zugriff läuft bis subscriptionPeriodEnd.
  subscriptionCancelAtEnd Boolean   @default(false)
  /// Stripe-Customer-ID (`cus_xxx`) — für Customer-Portal-Links.
  providerCustomerId      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mandanten                Mandant[]
  user                     User[]
  auditLogs                AuditLog[]
  konsolidierungsEinheiten KonsolidierungsEinheit[]
  apiKeys                  APIKey[]
  webhookSubscriptions     WebhookSubscription[]

  @@index([customDomain])
  @@map("kanzlei")
}

/// Ein Mandant = 1 GmbH (oder GmbH & Co. KG).
/// Gehört genau 1 Kanzlei.
model Mandant {
  id                 String    @id @default(uuid()) @db.Uuid
  kanzleiId          String    @db.Uuid
  firmenname         String
  rechtsform         String // "GmbH" | "GmbH & Co. KG" | "AG" | ...
  handelsregister    String? // "HRB 123456"
  ustId              String? // USt-IdNr.
  /// Finanzamt-Steuernummer, z.B. "12/345/67890" (HGB-KT genInfo.companyInfo.taxNumber).
  ///
  /// Bis 2026-10-01 existierte dieses Feld nicht; der E-Bilanz-Generator hat
  /// stattdessen die Handelsregisternummer in `taxNumber` geschrieben und
  /// sonst `MANDANT-<id>` erfunden. Beides ist eine falsche Angabe im
  /// E-Bilanz-Formular. Nullable, weil die Angabe bei Neuanlage nachgepflegt
  /// werden muss — ein erzwungener Wert würde bestehende Mandanten blockieren.
  steuernummer       String?
  adresse            Json // {strasse, plz, ort, land}
  geschaeftsfuehrer  Json // [{name, geburtsdatum, anteilProzent}]
  gruendungsdatum    DateTime?
  bilanzsummeVorjahr Decimal?  @db.Decimal(18, 2)
  umsatzVorjahr      Decimal?  @db.Decimal(18, 2)
  mitarbeiterAnzahl  Int?
  groessenklasse     String // "KLEINST" | "KLEIN" | "MITTEL" | "GROSS" (gem. § 267 HGB)
  publishChannel     String // "PDF_DIRECT" | "XML_XBRL" | "EBILANZ_TAXONOMIE"
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  kanzlei           Kanzlei                  @relation(fields: [kanzleiId], references: [id], onDelete: Cascade)
  userAccess        UserMandantRole[]
  bilanzen          Bilanz[]
  guvs              GuV[]
  anhaenge          Anhang[]
  jahresabschluesse Jahresabschluss[]
  submissions       BanzSubmission[]
  auditLogs         AuditLog[]
  alsMutterFuer     KonsolidierungsEinheit[] @relation("Mutter")

  @@unique([kanzleiId, firmenname])
  @@index([kanzleiId])
  @@index([groessenklasse])
  @@index([kanzleiId, groessenklasse])
  @@index([kanzleiId, publishChannel])
  @@map("mandant")
}

// ============================================================================
// User & RBAC
// ============================================================================

/// Globaler User-Account (kann Zugriff auf mehrere Mandanten haben via UserMandantRole).
model User {
  id               String    @id @default(uuid()) @db.Uuid
  kanzleiId        String?   @db.Uuid // null für System-Admin
  email            String    @unique
  passwordHash     String
  vorname          String
  nachname         String
  telefon          String?
  totpSecret       String? // Encrypted TOTP-Secret (otplib)
  totpEnabled      Boolean   @default(false)
  mfaRecoveryCodes String? // Encrypted, JSON-encoded Array
  lastLoginAt      DateTime?
  lastLoginIp      String?
  isActive         Boolean   @default(true)
  globalRole       String    @default("USER") // "USER" | "SYSTEM_ADMIN"
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  kanzlei                     Kanzlei?               @relation(fields: [kanzleiId], references: [id])
  mandantRoles                UserMandantRole[]
  auditLogs                   AuditLog[]
  sessions                    UserSession[]
  wpNotizenErstellt           WPNotiz[]              @relation("WPNotizErstellt")
  wpNotizenAcknowledged       WPNotiz[]              @relation("WPNotizAcknowledged")
  wpPruefungenErstellt        WPPruefungsAbschluss[] @relation("WPPruefungErstellt")
  wpPruefungenFreigegeben     WPPruefungsAbschluss[] @relation("WPPruefungFreigegeben")
  apiKeysCreated              APIKey[]               @relation("APIKeyErstellt")
  apiKeysRevoked              APIKey[]               @relation("APIKeyRevoked")
  webhookSubscriptionsCreated WebhookSubscription[]  @relation("WebhookErstellt")

  @@map("user")
}

/// Refresh-Token-Sessions (für JWT-Refresh).
model UserSession {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String    @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_session")
}

/// m:n-Zuordnung User × Mandant × Rolle.
model UserMandantRole {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  mandantId   String    @db.Uuid
  rolle       String // "GF" | "STEUERBERATER" | "WIRTSCHAFTSPRUEFER" | "KANZLEI_ADMIN"
  grantedAt   DateTime  @default(now())
  grantedById String?   @db.Uuid // welcher User hat die Rolle gewährt
  revokedAt   DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mandant Mandant @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  @@unique([userId, mandantId, rolle])
  @@index([userId])
  @@index([mandantId])
  @@map("user_mandant_role")
}

// ============================================================================
// Bilanz (Phase 1)
// ============================================================================

/// Bilanz eines Mandanten für ein Geschäftsjahr.
model Bilanz {
  id             String    @id @default(uuid()) @db.Uuid
  mandantId      String    @db.Uuid
  geschaeftsjahr Int // z.B. 2025
  erstelltAm     DateTime?
  gueltigBis     DateTime?
  status         String    @default("DRAFT") // "DRAFT" | "VALIDATED" | "ARCHIVED" | "APPROVED"
  hinweise       String? // Freitext-Notizen
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdById    String?   @db.Uuid
  updatedById    String?   @db.Uuid

  /// Konzernsatz (`null` = Einzelsatz). Siehe Kommentar beim
  /// partiellen Unique-Index.
  konzernEinheitId       String?   @db.Uuid

  mandant                Mandant                 @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  /// Konzernsatz: gehoert zu dieser Konsolidierungseinheit.
  /// Beim Loeschen der Einheit bleibt der Satz als Einzelsatz stehen.
  konzernEinheit         KonsolidierungsEinheit? @relation(fields: [konzernEinheitId], references: [id], onDelete: SetNull)
  positionen             BilanzPosition[]
  jahresabschluesse      Jahresabschluss[]
  pruefungsResults       BilanzPruefungsResult[]
  wpNotizen              WPNotiz[]
  wpPruefungsAbschluesse WPPruefungsAbschluss[]

  // Bugfix 2026-10-07 (Konzernmodell): `@@unique([mandantId,
  // geschaeftsjahr])` verhinderte, dass Einzelsatz und Konzernsatz der
  // MUTTER gleichzeitig existieren. Der Konzernabschluss wurde unter
  // `mutterMandantId` gespeichert und verdraengte den Einzelsatz — oder
  // `apply` scheiterte an genau diesem Constraint.
  //
  // Nach HGB §301 / IDW RS 11 ist der Konzernabschluss ein EIGENER
  // Abschluss neben dem Einzelsatz. Beide muessen bestehen koennen.
  //
  // Loesung: `konzernEinheitId` (nullable) + zwei partielle
  // Unique-Indizes in der Migration:
  //   UNIQUE (mandantId, geschaeftsjahr) WHERE konzernEinheitId IS NULL
  //   UNIQUE (kanzleiId, geschaeftsjahr, konzernEinheitId) WHERE ... IS NOT NULL
  //
  // Ein Spalten-Default wie `coalesce(...)` waere NICHT ausreichend:
  // Postgres-Zeilenscans vergleichen auch COALESCE-Ausdruecke — es
  // braucht echte partielle Indizes.
  @@index([mandantId])
  @@index([status])
  @@index([mandantId, status, geschaeftsjahr(sort: Desc)])
  @@index([mandantId, geschaeftsjahr(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("bilanz")
}

/// Einzelne Position einer Bilanz (z.B. "Bankguthaben", "Gezeichnetes Kapital").
/// Struktur nach HGB-Bilanzschema (§ 266 HGB).
model BilanzPosition {
  id            String   @id @default(uuid()) @db.Uuid
  bilanzId      String   @db.Uuid
  seite         String // "AKTIVA" | "PASSIVA"
  kontonummer   String // z.B. "0100" (SKR03/04) oder HGB-Position
  bezeichnung   String // "Bankguthaben", "Gezeichnetes Kapital"
  betragVorjahr Decimal? @db.Decimal(18, 2)
  betragAktuell Decimal  @db.Decimal(18, 2)
  reihenfolge   Int // Sortierung innerhalb der Seite
  bemerkung     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  bilanz    Bilanz    @relation(fields: [bilanzId], references: [id], onDelete: Cascade)
  wpNotizen WPNotiz[]

  @@index([bilanzId])
  @@index([seite])
  @@map("bilanz_position")
}

// ============================================================================
// GuV (Phase 1)
// ============================================================================

model GuV {
  id             String   @id @default(uuid()) @db.Uuid
  mandantId      String   @db.Uuid
  bilanzId       String?  @db.Uuid // Optional: GuV kann unabhängig sein
  geschaeftsjahr Int
  verfahren      String   @default("GKV") // "GKV" (Gesamtkostenverfahren) | "UKV" (Umsatzkostenverfahren)
  status         String   @default("DRAFT")
  hinweise       String?
  ergebnis       Decimal  @db.Decimal(18, 2) // Jahresüberschuss/fehlbetrag (validiert)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?  @db.Uuid
  updatedById    String?  @db.Uuid

  /// Konzernsatz (`null` = Einzelsatz). Siehe Kommentar beim
  /// partiellen Unique-Index.
  konzernEinheitId       String?   @db.Uuid

  mandant                Mandant                 @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  /// Konzernsatz: gehoert zu dieser Konsolidierungseinheit.
  /// Beim Loeschen der Einheit bleibt der Satz als Einzelsatz stehen.
  konzernEinheit         KonsolidierungsEinheit? @relation(fields: [konzernEinheitId], references: [id], onDelete: SetNull)
  positionen             GuVPosition[]
  jahresabschluesse      Jahresabschluss[]
  pruefungsResults       BilanzPruefungsResult[]
  wpNotizen              WPNotiz[]
  wpPruefungsAbschluesse WPPruefungsAbschluss[]

  // Bugfix 2026-10-07 (Konzernmodell): `@@unique([mandantId,
  // geschaeftsjahr])` verhinderte, dass Einzelsatz und Konzernsatz der
  // MUTTER gleichzeitig existieren. Der Konzernabschluss wurde unter
  // `mutterMandantId` gespeichert und verdraengte den Einzelsatz — oder
  // `apply` scheiterte an genau diesem Constraint.
  //
  // Nach HGB §301 / IDW RS 11 ist der Konzernabschluss ein EIGENER
  // Abschluss neben dem Einzelsatz. Beide muessen bestehen koennen.
  //
  // Loesung: `konzernEinheitId` (nullable) + zwei partielle
  // Unique-Indizes in der Migration:
  //   UNIQUE (mandantId, geschaeftsjahr) WHERE konzernEinheitId IS NULL
  //   UNIQUE (kanzleiId, geschaeftsjahr, konzernEinheitId) WHERE ... IS NOT NULL
  //
  // Ein Spalten-Default wie `coalesce(...)` waere NICHT ausreichend:
  // Postgres-Zeilenscans vergleichen auch COALESCE-Ausdruecke — es
  // braucht echte partielle Indizes.
  @@index([mandantId])
  @@index([mandantId, status, geschaeftsjahr(sort: Desc)])
  @@index([mandantId, geschaeftsjahr(sort: Desc)])
  @@map("guv")
}

model GuVPosition {
  id            String   @id @default(uuid()) @db.Uuid
  guvId         String   @db.Uuid
  kontonummer   String
  bezeichnung   String
  kategorie     String // "ERLOES" | "MATERIAL" | "PERSONAL" | "ABSCHREIBUNG" | "SONSTIGE" | "STEUER" | "FINANZ"
  betragVorjahr Decimal? @db.Decimal(18, 2)
  betragAktuell Decimal  @db.Decimal(18, 2)
  reihenfolge   Int
  bemerkung     String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  guv       GuV       @relation(fields: [guvId], references: [id], onDelete: Cascade)
  wpNotizen WPNotiz[]

  @@index([guvId])
  @@index([kategorie])
  @@map("guv_position")
}

// ============================================================================
// Anhang (Phase 1 minimal, Phase 2 vollständig)
// ============================================================================

model Anhang {
  id                     String   @id @default(uuid()) @db.Uuid
  mandantId              String   @db.Uuid
  geschaeftsjahr         Int
  status                 String   @default("DRAFT")
  bilanzierungsMethoden  String? // Freitext, § 284 HGB
  bewertungsMethoden     String?
  sonstigePflichtangaben String?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  createdById            String?  @db.Uuid
  updatedById            String?  @db.Uuid

  mandant           Mandant           @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  abschnitte        AnhangAbschnitt[]
  jahresabschluesse Jahresabschluss[]

  @@unique([mandantId, geschaeftsjahr])
  @@index([mandantId, geschaeftsjahr(sort: Desc)])
  @@map("anhang")
}

model AnhangAbschnitt {
  id          String   @id @default(uuid()) @db.Uuid
  anhangId    String   @db.Uuid
  titel       String // "Allgemeine Angaben", "Bilanzierungs- und Bewertungsmethoden"
  inhalt      String   @db.Text
  reihenfolge Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  anhang Anhang @relation(fields: [anhangId], references: [id], onDelete: Cascade)

  @@index([anhangId])
  @@map("anhang_abschnitt")
}

// ============================================================================
// Jahresabschluss (Orchestrierung Phase 2)
// ============================================================================

/// Ein Jahresabschluss = Bilanz + GuV + Anhang + (optional) Lagebericht.
/// Ist das zentrale Objekt für BAnz-Submission.
model Jahresabschluss {
  id                String    @id @default(uuid()) @db.Uuid
  mandantId         String    @db.Uuid
  geschaeftsjahr    Int
  bilanzId          String    @db.Uuid
  guvId             String    @db.Uuid
  anhangId          String    @db.Uuid
  lageberichtId     String?   @db.Uuid // Phase 2
  status            String    @default("DRAFT") // DRAFT | FINALIZED | SIGNED | SUBMITTED | PUBLISHED
  finalisiertAm     DateTime?
  signiertAm        DateTime?
  eingereichtAm     DateTime?
  veroeffentlichtAm DateTime?
  banzBestellnummer String? // @unique - BAnz-Vorgangsnummer nach Submission
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  createdById       String?   @db.Uuid
  finalizedById     String?   @db.Uuid

  mandant     Mandant          @relation(fields: [mandantId], references: [id], onDelete: Cascade)
  bilanz      Bilanz           @relation(fields: [bilanzId], references: [id])
  guv         GuV              @relation(fields: [guvId], references: [id])
  anhang      Anhang           @relation(fields: [anhangId], references: [id])
  signaturen  Signature[]
  submissions BanzSubmission[]
  auditLogs   AuditLog[]

  @@unique([mandantId, geschaeftsjahr])
  @@index([mandantId])
  @@index([status])
  @@map("jahresabschluss")
}

// ============================================================================
// Signatur (Phase 2)
// ============================================================================

model Signature {
  id                     String    @id @default(uuid()) @db.Uuid
  jahresabschlussId      String    @db.Uuid
  userId                 String    @db.Uuid // Wer hat signiert (WP / Steuerberater / GF)
  rolle                  String // "WIRTSCHAFTSPRUEFER" | "STEUERBERATER" | "GF"
  signaturTyp            String // "QUALIFIZIERT" | "FORTGESCHRITTEN" | "EINFACH"
  zertifikatSubject      String?
  zertifikatIssuer       String?
  zertifikatSeriennummer String?
  zertifikatGueltigAb    DateTime?
  zertifikatGueltigBis   DateTime?
  zeitstempel            DateTime
  zeitstempelIssuer      String? // TSA-Name
  hashVorher             String // SHA-256 des Dokuments vor Signatur
  hashNachher            String // SHA-256 des signierten Dokuments
  signaturDaten          Bytes // Signatur-Bytes (PEM/DER)
  signaturFormat         String    @default("PKCS7") // PKCS7 | PAdES | XAdES
  createdAt              DateTime  @default(now())

  jahresabschluss Jahresabschluss @relation(fields: [jahresabschlussId], references: [id], onDelete: Cascade)

  @@index([jahresabschlussId])
  @@index([userId])
  @@map("signature")
}

// ============================================================================
// BAnz-Submission (Phase 2)
// ============================================================================

model BanzSubmission {
  id                 String    @id @default(uuid()) @db.Uuid
  jahresabschlussId  String    @db.Uuid
  mandantId          String    @db.Uuid
  channel            String // "PDF_DIRECT" | "XML_XBRL" | "EBILANZ_TAXONOMIE"
  status             String    @default("PREPARED") // PREPARED | VALIDATED | SUBMITTED | ACCEPTED | PUBLISHED | REJECTED
  preparedAt         DateTime  @default(now())
  submittedAt        DateTime?
  banzVorgangsnummer String?
  banzBestellnummer  String?
  rawPayload         Bytes // Generierte XML/XBRL/PDF-Daten
  payloadFormat      String // "XML" | "XBRL" | "PDF" | "ZIP"
  payloadHash        String // SHA-256 für Integritätsprüfung
  banzResponse       Json? // BAnz-Portal-Antwort (idR JSON oder XML)
  errorMessage       String?
  retryCount         Int       @default(0)
  createdById        String?   @db.Uuid

  jahresabschluss Jahresabschluss @relation(fields: [jahresabschlussId], references: [id], onDelete: Cascade)
  mandant         Mandant         @relation(fields: [mandantId], references: [id], onDelete: Cascade)

  @@index([jahresabschlussId])
  @@index([mandantId])
  @@index([status])
  @@index([channel])
  @@map("banz_submission")
}

// ============================================================================
// WORM-Storage (Phase 1)
// ============================================================================

/// WORM-Storage-Manifest: Protokolliert jedes Objekt im Object-Lock-Storage.
/// Selbst unveränderlich (Append-Only).
model WormObject {
  id                 String   @id @default(uuid()) @db.Uuid
  objectKey          String   @unique // S3-Key
  entityType         String // "BILANZ_PDF" | "GUV_PDF" | "ANHANG_PDF" | "ABSCHLUSS_PDF" | "BILANZ_XML" | etc.
  entityId           String   @db.Uuid
  mandantId          String   @db.Uuid
  sha256Hash         String
  sizeBytes          Int
  objectLockMode     String // "COMPLIANCE" | "GOVERNANCE"
  retentionDays      Int // 3650 (10 Jahre)
  retentionExpiresAt DateTime
  uploadedById       String?  @db.Uuid
  uploadedAt         DateTime @default(now())
  legalHold          Boolean  @default(true)

  @@index([entityType, entityId])
  @@index([mandantId])
  @@index([retentionExpiresAt])
  @@index([entityType, entityId, uploadedAt(sort: Desc)])
  @@index([mandantId, retentionExpiresAt])
  @@map("worm_object")
}

// ============================================================================
// Audit-Trail (GoBD § 147 AO)
// ============================================================================

/// Append-only Audit-Log für alle Mutationen.
/// Erfasst VORHER/NACHHER-Zustand jeder Änderung (für Revisionssicherheit).
model AuditLog {
  id                String  @id @default(uuid()) @db.Uuid
  kanzleiId         String? @db.Uuid // null für System-Aktionen
  mandantId         String? @db.Uuid // null für kanzlei-übergreifend
  userId            String? @db.Uuid
  jahresabschlussId String? @db.Uuid // Optional: Bezug zu Abschluss
  action            String // "CREATE" | "READ" | "UPDATE" | "DELETE" | "SIGN" | "SUBMIT" | "LOGIN" | "LOGOUT" | "EXPORT"
  entityType        String // "Mandant" | "Bilanz" | "GuV" | "Anhang" | "Jahresabschluss" | "User" | ...
  entityId          String?
  previousState     Json? // Snapshot vor Mutation (null bei CREATE)
  newState          Json? // Snapshot nach Mutation (null bei DELETE)
  ipAddress         String?
  userAgent         String?
  geoLocation       String? // Optional: ISO-Country-Code

  // === Hash-Chain (M4 Sprint 5) ===
  /// SHA-256-Hash des Eintrags (hex, 64 Zeichen). Genesis-Hash = "0"*64.
  /// Berechnet als SHA-256(prevHash + serialize(entry)) für Manipulations-Erkennung.
  /// Nullable für Backwards-Compat: existierende Einträge vor Migration haben
  /// keinen Hash (verifyIntegrity() liefert dann PARTIAL-Status).
  entryHash String?
  /// Hash des vorherigen AuditLog-Eintrags in chronologischer Reihenfolge.
  /// Genesis-PrevHash = "0"*64 (für allerersten Eintrag).
  prevHash  String?

  createdAt DateTime @default(now())
  /// Monotone Sequenz fuer die Hash-Kette (§ 147 AO, GoBD
  /// Manipulationserkennung).
  ///
  /// BUGFIX 2026-10-08: Die Kette wurde ueber `(createdAt, id)`
  /// verketten. `id` ist eine ZUFALLS-UUID (uuid v4), die
  /// Verarbeitung laeuft aber in EINfuegereihenfolge
  /// (`AuditIntegrityService.enqueue`). Entstehen zwei Eintraege in
  /// derselben Millisekunde — bei einem Sammel-Import Regelfall —
  /// entscheidet die UUID, nicht die Einfuegereihenfolge. Wird der
  /// zweite Eintrag mit einer KLEINEREN UUID verarbeitet, findet er
  /// den ersten nicht als Vorgaenger und beginnt die Kette neu
  /// (GENESIS). Die Verifikation meldet dann BROKEN.
  ///
  /// Das war die Ursache der sporadisch roten audit-chain-e2e-Tests.
  /// Ein Hash-Kette braucht eine TOTALORDNUNG aus der Datenbank, nicht
  /// aus Zufallswerten. `BIGSERIAL` liefert sie.
  sequenz BigInt @default(autoincrement())

  kanzlei         Kanzlei?         @relation(fields: [kanzleiId], references: [id])
  mandant         Mandant?         @relation(fields: [mandantId], references: [id])
  user            User?            @relation(fields: [userId], references: [id])
  jahresabschluss Jahresabschluss? @relation(fields: [jahresabschlussId], references: [id])

  @@index([kanzleiId, sequenz])
  @@index([kanzleiId, createdAt])
  @@index([mandantId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([action])
  @@index([kanzleiId, action, createdAt(sort: Desc)])
  @@index([mandantId, action, createdAt(sort: Desc)])
  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), entryHash])
  @@map("audit_log")
}

// ============================================================================
// Konfig-Tabellen (Phase 2)
// ============================================================================

/// System-Konfiguration (Feature Flags, Rate Limits, etc.)
model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt

  @@map("system_config")
}

// ============================================================================
// Konzernabschluss / Konsolidierung (Phase M3 Sprint 1, PublG §11)
// ============================================================================

/// Eine Konsolidierungs-Einheit verbindet eine Mutter mit n Tochtern
/// zu einem virtuellen Konzern für ein Geschäftsjahr.
///
/// Der Mutter-Mandant ist Eigentümer der resultierenden Konzern-Bilanz
/// und Konzern-GuV. Alle Mandanten (Mutter + Tochtern) müssen zur selben
/// Kanzlei gehören — Mandant-Trennung wird im Service erzwungen.
model KonsolidierungsEinheit {
  id                       String    @id @default(uuid()) @db.Uuid
  kanzleiId                String    @db.Uuid
  mutterMandantId          String    @db.Uuid
  /// Postgres Array — Liste der Tochter-Mandant-IDs.
  /// Prisma 5.x mappt `String[]` nativ auf `text[]`.
  tochterMandantIds        String[]
  geschaeftsjahr           Int
  konsolidierungsArt       String    @default("VOLLKONSOLIDIERUNG") // VOLLKONSOLIDIERUNG | QUOTAL | AT_EQUITY
  status                   String    @default("DRAFT") // DRAFT | IN_PROGRESS | COMPLETED | VALIDATED
  konzernBilanzId          String?   @db.Uuid
  konzernGuvId             String?   @db.Uuid
  beteiligungsquote        Decimal   @db.Decimal(5, 2) // 0–100%
  anschaffungskosten       Decimal   @db.Decimal(18, 2)
  eigenkapitalTochter      Decimal   @db.Decimal(18, 2)
  jahresueberschussTochter Decimal   @db.Decimal(18, 2)
  erstellungsdatum         DateTime  @default(now())
  finalisiertAm            DateTime?
  finalisiertVonId         String?   @db.Uuid
  createdById              String?   @db.Uuid
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  kanzlei   Kanzlei                  @relation(fields: [kanzleiId], references: [id], onDelete: Cascade)
  mutter    Mandant                  @relation("Mutter", fields: [mutterMandantId], references: [id])
  buchungen KonsolidierungsBuchung[]
  konzernBilanzen Bilanz[]
  konzernGuVs GuV[]

  @@unique([mutterMandantId, geschaeftsjahr])
  @@index([kanzleiId])
  @@index([status])
  @@map("konsolidierungs_einheit")
}

/// Eine einzelne Konsolidierungs-Buchung gem. §§ 301–306 HGB.
/// Wird im Service automatisch generiert (calculateBuchungen) oder manuell
/// vom Wirtschaftsprüfer ergänzt.
model KonsolidierungsBuchung {
  id             String   @id @default(uuid()) @db.Uuid
  einheitId      String   @db.Uuid
  /// KAPITAL_KONSOLIDIERUNG | SCHULDEN_KONSOLIDIERUNG | ZWISCHENERGEBNIS
  /// | AUFWAND_ERTRAG | LATENTE_STEUERN
  buchungsArt    String
  beschreibung   String
  kontoSoll      String // SKR04-Konto Soll
  kontoHaben     String // SKR04-Konto Haben
  betrag         Decimal  @db.Decimal(18, 2)
  /// Optional: spezifischer Mandant, auf den sich die Buchung bezieht
  mandantId      String?  @db.Uuid
  /// Optional: Bezug auf Original-Buchung (z.B. konzerninterne Forderung)
  bezugId        String?  @db.Uuid
  reihenfolge    Int
  istAutomatisch Boolean  @default(true)
  createdAt      DateTime @default(now())

  einheit KonsolidierungsEinheit @relation(fields: [einheitId], references: [id], onDelete: Cascade)

  @@index([einheitId])
  @@index([buchungsArt])
  @@index([einheitId, buchungsArt])
  @@map("konsolidierungs_buchung")
}

// ============================================================================
// Wirtschaftsprüfung (M3 Sprint 0) — IDW PS 880 Plausi + WP-Workflow
// ============================================================================

/// Anmerkung eines Wirtschaftsprüfers zu einer Bilanz, GuV oder
/// einzelnen Position. Optional an `acknowledgedById` gebunden, wenn die
/// Gegenseite (Steuerberater/Mandant) darauf reagiert.
model WPNotiz {
  id               String    @id @default(uuid()) @db.Uuid
  bilanzId         String?   @db.Uuid
  guvId            String?   @db.Uuid
  bilanzPositionId String?   @db.Uuid
  guvPositionId    String?   @db.Uuid
  wpUserId         String    @db.Uuid
  notizText        String    @db.Text
  status           String    @default("PENDING") // PENDING | APPROVED | REJECTED | NEEDS_REVISION
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  acknowledgedAt   DateTime?
  acknowledgedById String?   @db.Uuid

  bilanz         Bilanz?         @relation(fields: [bilanzId], references: [id], onDelete: Cascade)
  guv            GuV?            @relation(fields: [guvId], references: [id], onDelete: Cascade)
  bilanzPosition BilanzPosition? @relation(fields: [bilanzPositionId], references: [id], onDelete: Cascade)
  guvPosition    GuVPosition?    @relation(fields: [guvPositionId], references: [id], onDelete: Cascade)
  wpUser         User            @relation("WPNotizErstellt", fields: [wpUserId], references: [id])
  acknowledgedBy User?           @relation("WPNotizAcknowledged", fields: [acknowledgedById], references: [id])

  @@index([bilanzId])
  @@index([guvId])
  @@index([wpUserId])
  @@index([status])
  @@index([bilanzPositionId, status])
  @@map("wp_notiz")
}

/// Konfiguration einer Prüfungs-Regel (z.B. IDW-Standardregeln).
/// `konfiguration` enthält schwellwert-/operator-/einheit-Metadaten.
model PruefungsRegel {
  id            String  @id @default(uuid()) @db.Uuid
  code          String  @unique // z.B. "IDW_EK_QUOTE"
  name          String // "Eigenkapitalquote ≥ 0"
  beschreibung  String  @db.Text
  schweregrad   String  @default("WARNUNG") // INFO | WARNUNG | KRITISCH
  istAktiv      Boolean @default(true)
  konfiguration Json // Regel-Parameter (Schwellwerte etc.)
  reihenfolge   Int     @default(0)

  @@map("pruefungs_regel")
}

/// Ergebnis einer Regel-Ausführung gegen eine Bilanz (optional GuV).
/// Pro (bilanzId, regelCode) genau ein Eintrag — wird bei Re-Run ersetzt.
model BilanzPruefungsResult {
  id              String   @id @default(uuid()) @db.Uuid
  bilanzId        String   @db.Uuid
  guvId           String?  @db.Uuid
  regelCode       String
  status          String // PASSED | WARNUNG | KRITISCH
  berechneterWert Decimal? @db.Decimal(18, 4)
  schwellwert     Decimal? @db.Decimal(18, 4)
  meldung         String
  geprueftAm      DateTime @default(now())

  bilanz Bilanz @relation(fields: [bilanzId], references: [id], onDelete: Cascade)
  guv    GuV?   @relation(fields: [guvId], references: [id])

  @@unique([bilanzId, regelCode])
  @@index([bilanzId])
  @@index([status])
  @@index([status, geprueftAm(sort: Desc)])
  @@map("bilanz_pruefungs_result")
}

/// WP-Prüfungs-Vorgang (Lebenszyklus: IN_PROGRESS → APPROVED | REJECTED).
/// Beim Finalize (APPROVED) wird Bilanz.status auf APPROVED gesetzt.
model WPPruefungsAbschluss {
  id                 String    @id @default(uuid()) @db.Uuid
  bilanzId           String    @db.Uuid
  guvId              String?   @db.Uuid
  wpUserId           String    @db.Uuid
  status             String    @default("IN_PROGRESS") // IN_PROGRESS | APPROVED | REJECTED
  zusammenfassung    String?   @db.Text
  startedAt          DateTime  @default(now())
  completedAt        DateTime?
  finalisierungAm    DateTime?
  finalisierungVonId String?   @db.Uuid

  /// Vier-Augen-Prinzip (IDW PS 880, § 11 Abs. 2 WPO): die Person, die
  /// die Prüfung DURCHFÜHRT hat, darf sie nicht selbst freigeben.
  ///
  /// Bis 2026-10-07 gab es nur `wpUserId` (den Prüfenden) und kein Feld
  /// für eine zweite Person — die Kontrolle war damit strukturell nicht
  /// erfüllbar. Statt sie vorzutäuschen, wird die Zweitperson jetzt
  /// ausdrücklich erfasst.
  ///
  /// `null` = noch nicht freigegeben (durfte bis 2026-10-07 nie
  /// passieren). Das Feld wird in `finalizePruefung` gesetzt und ist
  /// danach Pflicht.
  freigegebenVonId     String?   @db.Uuid
  /// Freigabe-Datum getrennt von `finalisierungAm`, damit die
  /// Freigabe des Prüfers im Aufzeichnungsstand erkennbar bleibt.
  freigegebenAm        DateTime?

  bilanz Bilanz @relation(fields: [bilanzId], references: [id], onDelete: Cascade)
  guv    GuV?   @relation(fields: [guvId], references: [id])
  wpUser User   @relation("WPPruefungErstellt", fields: [wpUserId], references: [id])
  freigegebenVon User? @relation("WPPruefungFreigegeben", fields: [freigegebenVonId], references: [id])

  @@index([bilanzId])
  @@index([status])
  @@index([bilanzId, status])
  @@map("wp_pruefungs_abschluss")
}

// ============================================================================
// Public API (M4 Sprint 1) — API-Keys + Webhooks
// ============================================================================

/// Ein API-Key für externe Integrationen (DATEV, Addison, ERP-Systeme).
/// Bound an genau eine Kanzlei (mandant-trennend). Secret wird nur als
/// SHA-256-Hash persistiert; ein einmaliger Plaintext wird bei Create
/// zurückgegeben und muss vom User kopiert werden.
///
/// Scopes: Array aus "bilanz:read", "guv:write", "banz:write", etc.
model APIKey {
  id          String    @id @default(uuid()) @db.Uuid
  kanzleiId   String    @db.Uuid
  name        String // z.B. "DATEV-Integration-Production"
  keyId       String    @unique // Public-Key-Id (z.B. "ak_abc123def456")
  keyHash     String // SHA-256-Hash des Secret-Keys (NIE Plain!)
  scopes      String[] // ["bilanz:read", "guv:read", "banz:write", ...]
  rateLimit   Int       @default(1000) // pro Stunde
  expiresAt   DateTime? // null = unlimited
  isActive    Boolean   @default(true)
  lastUsedAt  DateTime?
  createdAt   DateTime  @default(now())
  createdById String?   @db.Uuid
  revokedAt   DateTime?
  revokedById String?   @db.Uuid

  kanzlei   Kanzlei       @relation(fields: [kanzleiId], references: [id], onDelete: Cascade)
  createdBy User?         @relation("APIKeyErstellt", fields: [createdById], references: [id])
  revokedBy User?         @relation("APIKeyRevoked", fields: [revokedById], references: [id])
  usage     APIKeyUsage[]

  @@index([kanzleiId])
  @@index([keyId])
  @@index([isActive, expiresAt])
  @@map("api_key")
}

/// Einzelne API-Key-Nutzung (für Usage-Analytics + Rate-Limiting-Audit).
/// Append-only; wird durch einen Cron-Job nach >90 Tagen archiviert.
model APIKeyUsage {
  id             String   @id @default(uuid()) @db.Uuid
  apiKeyId       String   @db.Uuid
  endpoint       String // z.B. "GET /api/v1/mandanten"
  statusCode     Int
  timestamp      DateTime @default(now())
  ipAddress      String?
  responseTimeMs Int?

  apiKey APIKey @relation(fields: [apiKeyId], references: [id], onDelete: Cascade)

  @@index([apiKeyId, timestamp(sort: Desc)])
  @@map("api_key_usage")
}

/// Eine Webhook-Subscription für ausgehende Event-Benachrichtigungen
/// (z.B. an DATEV-Server bei "banz.submission.published"). Secret wird
/// bei Erstellung einmalig zurückgegeben; HMAC-SHA256 über Payload.
///
/// Mandant-Trennung: jede Subscription bound an genau 1 Kanzlei.
model WebhookSubscription {
  id                 String    @id @default(uuid()) @db.Uuid
  kanzleiId          String    @db.Uuid
  url                String // z.B. "https://datev.example.com/webhooks/banz"
  events             String[] // ["banz.submission.created", "bilanz.updated", ...]
  secret             String // HMAC-Secret für Webhook-Signature
  isActive           Boolean   @default(true)
  createdAt          DateTime  @default(now())
  createdById        String?   @db.Uuid
  lastDeliveryAt     DateTime?
  lastDeliveryStatus Int? // 200, 500, etc.

  kanzlei    Kanzlei           @relation(fields: [kanzleiId], references: [id], onDelete: Cascade)
  createdBy  User?             @relation("WebhookErstellt", fields: [createdById], references: [id])
  deliveries WebhookDelivery[]

  @@index([kanzleiId])
  @@index([isActive])
  @@map("webhook_subscription")
}

/// Eine einzelne Webhook-Delivery (mit Retry-Logik).
/// status: PENDING → SUCCESS | FAILED → DEAD_LETTER (nach 3 Versuchen).
model WebhookDelivery {
  id             String    @id @default(uuid()) @db.Uuid
  subscriptionId String    @db.Uuid
  event          String // "banz.submission.created"
  payload        Json // Vollständige Event-Daten
  attemptCount   Int       @default(0)
  maxAttempts    Int       @default(3)
  status         String    @default("PENDING") // PENDING | SUCCESS | FAILED | DEAD_LETTER
  responseCode   Int?
  responseBody   String? // Erste 500 Zeichen der Server-Response
  errorMessage   String?
  scheduledAt    DateTime  @default(now())
  completedAt    DateTime?
  nextRetryAt    DateTime? // Falls FAILED mit < maxAttempts

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@index([subscriptionId, status, scheduledAt])
  @@index([status, nextRetryAt])
  @@map("webhook_delivery")
}
